# Settings for the scheduled runs (step 6). start_airflow.sh reads them.
# Copy this file to airflow.env in the same folder and fill it in.
# airflow.env is in .gitignore because it holds passwords.

# The real workbook, the meal list, and where the files are written
export WORKBOOK_PATH="/path/to/the/workbook.xlsx"
export MEALS_PATH="/path/to/meals.xlsx"
export OUTPUT_DIR="/path/to/output"

# The day you switch the schedule on: Airflow makes up runs from this day
export SCHEDULE_START_DATE=2026-11-12

# PostgreSQL
export PGHOST=localhost
export PGPORT=5432
export PGDATABASE=shawarma_classic
export PGUSER=postgres
export PGPASSWORD=change-me

# Alert emails, sent from a Gmail account. The password is a Gmail app
# password, not the account's normal one: turn on 2-Step Verification, then
# create one at https://myaccount.google.com/apppasswords
# Several addresses in ALERT_EMAIL_TO are separated by commas.
export ALERT_EMAIL_FROM=sender@gmail.com
export ALERT_EMAIL_PASSWORD=change-me
export ALERT_EMAIL_TO=you@example.com
