# Connection settings read by notebook 02. Set them as environment variables
# in the terminal you start Jupyter from (export on macOS/Linux, set on Windows).
# The defaults below are used for any you leave unset, except the password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=shawarma_classic
PGUSER=postgres
PGPASSWORD=change-me

# Set to 0 to skip the database step and only build the rankings.
LOAD_TO_DB=1
